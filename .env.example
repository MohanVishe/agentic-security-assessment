# Copy to .env and fill in LLM_API_KEY. Everything else has a working default.

# --- LLM: any OpenAI-compatible chat endpoint with tool calling -------------
# Groq (default, free tier): create a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Other providers: change the three values above.
#   Groq, Qwen         LLM_MODEL=qwen/qwen3.8-27b
#   Google Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter         LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama (local)     LLM_BASE_URL=http://host.docker.internal:11434/v1   LLM_API_KEY=ollama
#                      LLM_MODEL=qwen2.5:7b-instruct

# Optional second provider, used when the first is rate limited or down.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# --- optional: tracing and evaluation with Langfuse (https://langfuse.com) ---
# Leave empty to switch tracing off. With the three values set, every run becomes a
# Langfuse trace (one span per agent, LLM call and tool run) and gets quality scores.
# For a Langfuse running on this machine use  LANGFUSE_HOST=http://host.docker.internal:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- shared secrets between the containers: change them --------------------
LANGFLOW_API_KEY=change-me-langflow-key
INTERNAL_TOKEN=change-me-internal-token

# Host port for the Juice Shop demo target
JUICE_SHOP_PORT=3001
